# Copy to .env — never commit a real .env, and never put secrets here.
# Frontend config only. No API keys belong in this file or in the bundle.
# Leave VITE_API_URL empty to use the Vite /api proxy (backend on :8000),
# or set it to the FastAPI base URL, e.g. http://127.0.0.1:8000
VITE_API_URL=
# Set to "true" to force labelled mock mode even if a backend is reachable.
VITE_MOCK_MODE=true
# SpacetimeDB — leave empty in mock mode. When set, the app attempts a
# live SpacetimeDB SDK connection; without generated module bindings and
# a real host/token it will report "not connected" instead of faking it.
VITE_SPACETIMEDB_HOST=
VITE_SPACETIMEDB_DB=nemoproxy
