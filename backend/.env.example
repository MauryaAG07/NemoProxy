# NemoProxy backend environment — copy to `.env` (never commit a real `.env`).
# Placeholder values only. No real secrets belong in this file.
# See backend/README.md and BACKEND_CONTRACT.md for what each setting does.

# NVIDIA Nemotron (hosted OpenAI-compatible API). Leave the key empty to
# run in demo mode (labelled simulated tool loop); a live call is never
# faked when the key is missing or the call fails.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://api.nvidia.com/v1
# Do NOT hardcode nvidia/nemotron-4-340b-instruct. Default model with
# verified structured tool calling:
NVIDIA_MODEL_ID=nvidia/nemotron-3-nano-30b-a3b

# SpacetimeDB. Database names cannot contain underscores (use "nemo-proxy").
# The v1 call endpoint addresses databases by identity, not by name.
SPACETIME_HOST=http://127.0.0.1:3000
SPACETIME_DB=nemo-proxy
# Hex identity of the published `nemo-proxy` database (from `spacetime publish`).
SPACETIME_DB_IDENTITY=
# Backend service identity token (JWT) for the CLI identity that published
# the module — e.g. the `spacetimedb_token` in ~/.config/spacetime/cli.toml.
# Without it, reducer calls are anonymous, get rejected, and the backend
# silently falls back to the in-memory mirror (labelled in_memory_fallback).
SPACETIME_TOKEN=

# External reputation service (Google Web Risk). One provider only.
# Empty = reputation tool returns the explicitly labelled simulated fixture.
WEB_RISK_API_KEY=

# Demo mode. true = in-memory mirror, labelled simulated Nemotron/reputation.
# false = live SpacetimeDB + live Nemotron (needs the keys above).
DEMO_MODE=true

# Optional shared key for the demo write endpoints (X-Demo-Key header on
# POST /api/ingest and the /api/session/* endpoints). Unset = endpoints open.
DEMO_API_KEY=

# Explicit CORS origins for the local React dev server (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Nemotron investigation budgets (spec §4). Exhaustion returns an
# understandable `incomplete` status with partial evidence kept — never a
# simulated verdict. Lower INVESTIGATION_MAX_TOOL_CALLS to 2 to force it.
INVESTIGATION_MAX_ROUNDS=6
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_TIMEOUT_SECONDS=120
